# The engine on a machine of its own. Copy to .env beside the compose files.

# prod refuses to start without a token.
ENGINE_ENV=prod
# How many captures are checked at once; each worker holds its own copy of the
# models, up to about 1 GB of GPU memory.
ENGINE_WORKERS=1

# Where the engine listens on this machine. A port alone listens on every
# interface; an address and port, such as 10.0.0.5:8000, only on that one —
# the safer choice, since Docker's published ports bypass host firewalls such
# as ufw.
ENGINE_PUBLISH=8000
