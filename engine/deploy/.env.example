# The engine on a host of its own. Copy to .env beside compose.yml.

# prod refuses to start without a token.
ENGINE_ENV=prod
# How many captures are checked at once; each worker holds its own copy of the
# models, up to about 1 GB of GPU memory.
ENGINE_WORKERS=1

# A copy of the provider's provider/keys/engine.token. Both sides must hold the
# same one.
ENGINE_TOKEN_PATH=./engine.token

# Where the engine listens on this host. Loopback by default; for a provider on
# another host, the address it reaches, with compose.tls.yml.
ENGINE_PUBLISH=0.0.0.0:8443

# cert.pem and key.pem, for compose.tls.yml.
ENGINE_TLS_DIR=./tls
