# Started by 99-iden-kiosk-camera.rules for each camera that appears, at boot
# or when plugged in, and stopped when it is unplugged.
[Unit]
Description=IDEN kiosk: hold camera %I at the settings in camera.conf
BindsTo=dev-%i.device
After=dev-%i.device

[Service]
ExecStart=/opt/iden-kiosk/camera.sh %i
Restart=on-failure
