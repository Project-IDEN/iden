# The kiosk server. In Docker these come from kiosk/deploy/compose.yml instead.
KIOSK_ENV=dev
KIOSK_LOG_LEVEL=info
# IDEN's public address — the issuer.
KIOSK_ISSUER=http://localhost:8000
# Where credentials.json is kept.
KIOSK_DATA_DIR=data
# The built UI (web/kiosk/dist). Leave unset in development: Vite serves it.
# KIOSK_UI_DIR=../../web/kiosk/dist
