# The provider's origin — what this app calls. Under `pnpm dev` that is a
# different origin from this app, so *this app's* origin must appear in the
# provider's IDEN_ALLOWED_ADMIN_ORIGINS: credentialed CORS permits the caller,
# not the callee. Behind one origin in production there is nothing to list.
VITE_IDEN_ISSUER=http://localhost:8000

# Shown instead of IDEN wherever the brand appears. Leave unset and IDEN stands
# alone. The logo is any URL the browser can reach.
VITE_IDEN_ORG_NAME=
VITE_IDEN_ORG_LOGO=

# Shown beside the email field when adding a user. Must match the provider's
# IDEN_MAIL_DOMAIN, which is what actually decides the address.
VITE_IDEN_MAIL_DOMAIN=localhost
