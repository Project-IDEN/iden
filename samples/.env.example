# Settings for docker-compose.yml. Copy to .env and fill in.

# Your deployment, verbatim — scheme and port included. deploy/.env must hold
# exactly the same string; the issuer is compared character for character.
IDEN_ISSUER=https://iden.example.org

# Where the browser reaches each sample. Behind a tunnel these are the mapped
# hostnames; leave them out on your own machine and localhost applies. Each
# client's redirect URI must be registered against the value used here.
PORTAL_ORIGIN=https://portal.example.org
LIBRARY_ORIGIN=https://library.example.org
NEXTJS_ORIGIN=https://nextjs.example.org
DOOR_PANEL_ORIGIN=https://door.example.org

# The clients you registered. The seed does not create them.
PORTAL_CLIENT_ID=demo-portal
LIBRARY_CLIENT_ID=demo-library
NEXTJS_CLIENT_ID=demo-nextjs
DOOR_PANEL_CLIENT_ID=demo-door-panel

# The two confidential clients. Each secret is shown once, at registration.
NEXTJS_CLIENT_SECRET=
DOOR_PANEL_CLIENT_SECRET=

# The audience on the `door` resource API. The controller refuses any token
# not addressed to exactly this string. See door-access/README.md.
DOOR_AUDIENCE=https://api.example.org/door

# Where this server reaches the door controller. Not a browser URL — the
# browser never talks to it.
DOOR_API_ORIGIN=http://localhost:5400

# Signs Auth.js's own cookie, nothing to do with IDEN: openssl rand -base64 32
AUTH_SECRET=
