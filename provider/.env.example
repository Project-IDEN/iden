# Application
export IDEN_ENV=dev
export IDEN_LOG_LEVEL=info
# Leave empty. OIDC requires /.well-known/* at the host root; each router
# declares its own prefix. Only set this to mount IDEN under a sub-path.
export IDEN_API_PREFIX=
# Every browser origin allowed to call the provider directly. The dashboard
# (5173 in `pnpm dev`, 3000 in a container) and the sample playground (5100).
# Credentialed CORS forbids a wildcard, so every origin is named.
export IDEN_ALLOWED_ADMIN_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:5100"]

# Addresses whose X-Forwarded-For is believed. Empty trusts nobody, which is
# right here: nothing sits in front of a provider you are running directly.
# Behind a proxy this is what decides who a request is attributed to -- both the
# per-address rate limits and the audit log's `ip` column read the result. Name
# the proxy's network there, and never `*`.
export IDEN_FORWARDED_ALLOW_IPS=

# Issuer — must match exactly what clients use, or issuer validation fails
export IDEN_ISSUER=http://localhost:8000
export IDEN_AUTH_UI_BASE_URL=http://localhost:4000

# Who people think they are signing in to. The frontends read the same variable
# for the brand lockup; here it is the name an authenticator app files a TOTP
# credential under. Empty means IDEN.
export IDEN_ORG_NAME=

# Storage
export IDEN_DATABASE_URL=postgresql+asyncpg://iden:iden@localhost:5432/iden
export IDEN_REDIS_URL=redis://localhost:6379/0

# Blob storage, over the S3 API. Leave the endpoint empty and profile photos
# are unavailable; everything else works. `deploy/docker-compose.yml` runs
# SeaweedFS on 8333, but MinIO, Garage, or AWS S3 answer the same API.
export IDEN_S3_ENDPOINT_URL=http://localhost:8333
export IDEN_S3_ACCESS_KEY=iden
export IDEN_S3_SECRET_KEY=idensecret
export IDEN_S3_BUCKET=iden
# Required by the S3 signature even where the store ignores it.
export IDEN_S3_REGION=us-east-1
# Refused before the upload is decoded. Generous for a photo, small enough
# that an upload cannot make the provider hold a large buffer.
export IDEN_AVATAR_MAX_BYTES=5242880

# Crypto — each PEM file's stem in this directory becomes its kid
export IDEN_SIGNING_KEY_DIR=keys
export IDEN_SIGNING_ALGORITHM=RS256

# Lifetimes (seconds)
export IDEN_ACCESS_TOKEN_TTL=600
export IDEN_ID_TOKEN_TTL=600
export IDEN_REFRESH_TOKEN_TTL=2592000
export IDEN_AUTH_CODE_TTL=60
export IDEN_SESSION_TTL=86400
export IDEN_CHALLENGE_TTL=600
# How long a spent refresh token still returns what it was exchanged for, so a
# retried or doubled request is not mistaken for a stolen token. 0 disables it.
export IDEN_REFRESH_GRACE_PERIOD=30

# Rate limiting. Off only for a load test against a deployment you own: with
# it off, /api/v1/auth/login is both a brute-force target and a way to exhaust
# the machine's CPU, since argon2 is expensive for the server.
export IDEN_RATE_LIMIT_ENABLED=true

# Developer self-service. How many applications one account may register
# through /developer/clients before an administrator has to get involved.
export IDEN_DEVELOPER_MAX_CLIENTS=5

# Bootstrap — password is generated and printed once when left empty
export IDEN_BOOTSTRAP_ADMIN_EMAIL=admin@localhost
export IDEN_BOOTSTRAP_ADMIN_PASSWORD=

# Biometric extension
export IDEN_BIOMETRIC_ENABLED=false
export IDEN_ENGINE_BASE_URL=http://engine:8000
