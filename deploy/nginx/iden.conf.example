# Reference reverse proxy for a single-origin IDEN deployment behind a
# Cloudflare Tunnel. Copy to iden.conf and change the two marked values.
#
#   browser --HTTPS--> Cloudflare --tunnel--> cloudflared --HTTP--> nginx --> apps
#
# No TLS here on purpose: Cloudflare terminates it at the edge and cloudflared
# speaks plain HTTP to the origin, so a `listen 443 ssl` block would never be
# reached and an http->https redirect would loop forever. See
# doc/operations/cloudflare-tunnel.md.
#
# One origin, three applications:
#
#   /oauth2/*  /.well-known/*  /admin/*  /entity/*  /developer/*
#   /api/v1/auth/*  /media/*                                 -> provider
#   /auth/*                                                  -> auth-ui
#   /console/*                                               -> dashboard
#
# The dashboard is on /console because the provider's API owns /admin/* and the
# dashboard's own admin screens have the same names. Both frontends have a
# matching Vite `base`, so their assets cannot collide.
#
# IDEN_ISSUER, IDEN_AUTH_UI_BASE_URL and the dashboard client's redirect URI must
# all name this origin; the issuer is compared character for character, and a
# mismatch fails as a sign-in loop rather than an error.

upstream iden_provider  { server provider:8000; keepalive 32; }
upstream iden_auth_ui   { server auth-ui:4000;  keepalive 16; }
upstream iden_dashboard { server dashboard:3000; keepalive 16; }

# The network cloudflared connects from; docker-compose.tunnel.yml pins it so
# this value can be written down rather than looked up after every `up`. Keep
# IDEN_FORWARDED_ALLOW_IPS in step with both.
#
# Everything on this range is trusted to state the caller's address, so keep it
# as narrow as the deployment allows.
set_real_ip_from 172.31.250.0/24;

# Cloudflare's own header, not X-Forwarded-For: it always holds exactly one
# address — the peer Cloudflare itself observed — and the edge overwrites
# whatever the client sent. Trustworthy here precisely because the tunnel is
# the only way in; publish a port to the origin and it stops being.
real_ip_header CF-Connecting-IP;

# The coarse limit: IDEN's own are per account and per address and sit behind
# Python, while this refuses a flood before Python is involved. Keyed on
# $binary_remote_addr, which real_ip has already corrected — otherwise it would
# limit the tunnel as one client, which is the entire internet in one bucket.
limit_req_zone $binary_remote_addr zone=iden_credentials:10m rate=10r/s;
# Default is 503, which reads as an outage and carries no Retry-After. RFC 6585
# says 429, and that is what client libraries back off on.
limit_req_status 429;

server {
  # The tunnel decides which hostnames reach this origin, so there is nothing
  # for nginx to filter on. default_server means a request that arrives with an
  # unexpected Host is still answered rather than falling through to nowhere.
  listen 80 default_server;
  server_name _;

  # Applies wherever a location does not override it. The one upload IDEN
  # accepts is a profile photo, and its own limit is IDEN_AVATAR_MAX_BYTES;
  # nginx's 1m default would refuse a 3 MB photo first, with an HTML error page
  # instead of the documented JSON one.
  client_max_body_size 1m;

  # --- provider: OIDC protocol and both resource servers ---

  # Exact matches, taking precedence over the /oauth2/ prefix below. All three
  # verify a client secret with argon2, and none needs a credential to reach, so
  # the cost is spent before the caller has proved anything.
  location = /oauth2/token {
    limit_req zone=iden_credentials burst=20 nodelay;
    proxy_pass http://iden_provider;
    include /etc/nginx/conf.d/proxy.inc;
  }

  location = /oauth2/revoke {
    limit_req zone=iden_credentials burst=20 nodelay;
    proxy_pass http://iden_provider;
    include /etc/nginx/conf.d/proxy.inc;
  }

  location = /oauth2/introspect {
    limit_req zone=iden_credentials burst=20 nodelay;
    proxy_pass http://iden_provider;
    include /etc/nginx/conf.d/proxy.inc;
  }

  # Everything else under /oauth2, `/authorize` above all: it writes a challenge
  # into Redis for anyone who asks, and those entries live beside the sessions.
  # Generous, because a single sign-on hop passes through here for every
  # application someone opens.
  location ^~ /oauth2/ {
    limit_req zone=iden_credentials burst=40 nodelay;
    proxy_pass http://iden_provider;
    include /etc/nginx/conf.d/proxy.inc;
  }

  location ^~ /.well-known/ {
    proxy_pass http://iden_provider;
    include /etc/nginx/conf.d/proxy.inc;
  }

  # Where a password is checked. argon2 is deliberately slow, so this is both a
  # brute-force target and a way to spend the machine's CPU.
  location ^~ /api/v1/auth/ {
    limit_req zone=iden_credentials burst=20 nodelay;
    proxy_pass http://iden_provider;
    include /etc/nginx/conf.d/proxy.inc;
  }

  # The admin API. The trailing slash matters: without it this would also
  # capture /administrators and anything else merely starting with the word.
  location ^~ /admin/ {
    proxy_pass http://iden_provider;
    include /etc/nginx/conf.d/proxy.inc;
  }

  # The one endpoint that accepts a file.
  location = /entity/profile/photo {
    client_max_body_size 6m;
    proxy_pass http://iden_provider;
    include /etc/nginx/conf.d/proxy.inc;
  }

  location ^~ /entity/ {
    proxy_pass http://iden_provider;
    include /etc/nginx/conf.d/proxy.inc;
  }

  # Self-service application registration. Absent here, the catch-all 404 below
  # answers it instead — the API is up, the dashboard's Applications screen is
  # not, and nothing says why.
  location ^~ /developer/ {
    proxy_pass http://iden_provider;
    include /etc/nginx/conf.d/proxy.inc;
  }

  # Profile photos. Public by design — this is the URL in the `picture` claim,
  # fetched by <img> tags that cannot present a token.
  location ^~ /media/ {
    proxy_pass http://iden_provider;
    include /etc/nginx/conf.d/proxy.inc;
  }

  # --- the frontends ---

  location = /auth { return 301 /auth/; }

  location ^~ /auth/ {
    proxy_pass http://iden_auth_ui;
    include /etc/nginx/conf.d/proxy.inc;
  }

  location = /console { return 301 /console/; }

  location ^~ /console/ {
    proxy_pass http://iden_dashboard;
    include /etc/nginx/conf.d/proxy.inc;
  }

  # --- everything else ---

  # The bare origin is the dashboard, which now lives one level down.
  location = / { return 302 /console/; }

  # Health is for whoever runs this deployment, not for the internet: it says
  # whether PostgreSQL and Redis are reachable. Point monitoring at the
  # provider container directly.
  location = /health      { deny all; }
  location ^~ /health/    { deny all; }

  # /docs, /redoc and /openapi.json are deliberately absent. The provider
  # already refuses to serve them when IDEN_ENV=prod; not routing them here
  # means a deployment that is accidentally still in dev does not publish the
  # shape of its admin API either.

  # No path but the ones above belongs to anything. Saying so is what stops a
  # future frontend route from being quietly answered by the API.
  location / { return 404; }
}
