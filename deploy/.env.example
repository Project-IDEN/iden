# Deployment-specific settings for deploy/docker-compose.yml. Copy to .env.
#
#   cp deploy/.env.example deploy/.env
#
# Compose reads deploy/.env automatically. Leave a value out and the default in
# docker-compose.yml applies, which in every case is a laptop.

# ---------------------------------------------------------------------------
# The hostname. All three must be the same origin, and it must be the one
# people actually type: it is written into every token and compared character
# for character, so changing it later invalidates everything already issued.
#
# One origin serves all three applications — the provider at the root, the
# sign-in page under /auth, the dashboard under /console.
# ---------------------------------------------------------------------------
IDEN_ENV=prod
IDEN_ISSUER=https://iden.example.org
IDEN_AUTH_UI_BASE_URL=https://iden.example.org

# Empty is correct for a single origin: the dashboard is served from the same
# origin as the provider, so its calls are not cross-origin and there is
# nothing to allow. Name an origin here only for a browser application on a
# different host that calls the provider directly.
IDEN_ALLOWED_ADMIN_ORIGINS=[]

# The network nginx proxies from, so the provider believes its X-Forwarded-For
# and attributes requests to the real caller rather than to the proxy. Must
# match the subnet in docker-compose.tunnel.yml. Never `*`.
IDEN_FORWARDED_ALLOW_IPS=172.31.250.0/24

# ---------------------------------------------------------------------------
# Branding. Shown on the sign-in page, in the dashboard, and in the
# authenticator app people scan their TOTP QR code with.
#
# The organization takes the larger type and IDEN drops to a caption beneath
# it. Leave IDEN_ORG_NAME empty and IDEN stands alone — setting it to "IDEN"
# is the same result with one more thing configured.
#
# Authenticator apps file the credential as "<name>: <account>", so this is
# what someone sees next to their code six months from now. Colons and slashes
# are dropped there: they are what the label is split on.
#
# The logo must be a URL that returns an *image*. A repository link is a
# common mistake and fails silently, because the <img> loads a web page:
#
#   github.com/<user>/<repo>/blob/<ref>/logo.png          -> text/html
#   raw.githubusercontent.com/<user>/<repo>/<ref>/logo.png -> image/png
# ---------------------------------------------------------------------------
IDEN_ORG_NAME=Example University
IDEN_ORG_LOGO_URL=

# ---------------------------------------------------------------------------
# The first administrator's address, used by `scripts.seed`.
#
# Read ONLY when the seed creates the account. Against an administrator that
# already exists the seed changes nothing — it never resets a credential — so
# a new address here seeds a *second* administrator rather than renaming the
# first.
#
# There is no password setting to go with it, on purpose: a password put here
# would sit in the container's environment for as long as the container lives,
# where `docker inspect` reads it, to save typing one once. The seed generates
# a good one and prints it a single time. To choose your own, give it to that
# one command instead, where it does not outlive it:
#
#   docker compose -f deploy/docker-compose.yml exec \
#     -e IDEN_BOOTSTRAP_ADMIN_PASSWORD='...' provider python -m scripts.seed
# ---------------------------------------------------------------------------
IDEN_BOOTSTRAP_ADMIN_EMAIL=admin@example.org

# Only the settings a deployment usually changes are listed here. Every other
# provider setting can also go in this file — token lifetimes, rate limiting,
# the developer quota — and `docker-compose.yml` passes the whole set through
# with its defaults. See doc/reference/configuration.md for the list.

# ---------------------------------------------------------------------------
# The stores' own credentials.
#
# Each defaults to a value published in docker-compose.yml, which is right for a
# laptop and wrong for anything reachable. Set all three before a deployment
# leaves your machine, to values you generate:
#
#   openssl rand -base64 24
#
# They protect different things and are worth separate values. PostgreSQL holds
# every password hash. Redis holds every live session — its id is the cookie, so
# read access to Redis is read access to everyone's account. The blob store holds
# profile photos.
#
# Changing them after the first `up` does not re-key the existing volumes:
# PostgreSQL and SeaweedFS keep the credential they were initialised with, so set
# these first, or remove the volumes and start over.
# ---------------------------------------------------------------------------
IDEN_POSTGRES_PASSWORD=
IDEN_REDIS_PASSWORD=
IDEN_S3_ACCESS_KEY=
IDEN_S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# The tunnel. Create one at Cloudflare Zero Trust > Networks > Tunnels and
# copy its token. It is a credential: it authenticates this host as the tunnel,
# so treat it the way you treat a password.
# ---------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=
